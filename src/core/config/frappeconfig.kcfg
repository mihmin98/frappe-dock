<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="frappe-dockrc"/>

  <group name="General">
    <entry name="position" type="Enum">
      <label>Screen edge the dock is anchored to</label>
      <choices>
        <choice name="Bottom"/>
        <choice name="Left"/>
        <choice name="Right"/>
      </choices>
      <default>Bottom</default>
    </entry>

    <entry name="displayMode" type="Enum">
      <label>Which outputs carry a dock</label>
      <choices>
        <choice name="FollowActive"/>
        <choice name="AllScreens"/>
        <choice name="SingleScreen"/>
      </choices>
      <default>AllScreens</default>
    </entry>

    <entry name="targetOutput" type="String">
      <label>Output the dock is pinned to in SingleScreen mode</label>
      <default></default>
    </entry>

    <!-- S in the proportion model (plan.md Part 0): the tile edge in pt, i.e. the
         layout cell. Every other dimension is derived from it — gap S/3, pitch
         4S/3, shelf thickness 5S/3, corner radius 0.28 x thickness, screen gap
         S/9. This is deliberately the only dimension in the schema. -->
    <entry name="tileSize" type="Int">
      <label>Tile size in points</label>
      <default>48</default>
      <min>24</min>
      <max>128</max>
    </entry>

    <!-- Magnification. These are behaviour, not dimensions: none of them can be
         read from the reference screenshot, which has magnification off. They
         come from the falloff prototype and the tuning harness, and the values
         here are the frozen result (see docs/decisions/). Every one is a ratio
         rather than a length, so the proportion model still has exactly one
         dimension in it — tileSize. -->
    <entry name="magnificationEnabled" type="Bool">
      <label>Enlarge tiles near the pointer</label>
      <default>true</default>
    </entry>

    <!-- Peak tile size as a multiple of S, stored x100 because KConfigXT has no
         range-checked real. 200 = a tile at twice its resting size. -->
    <entry name="magnificationFactor" type="Int">
      <label>Peak tile size, as a percentage of the resting tile size</label>
      <default>200</default>
      <min>100</min>
      <max>300</max>
    </entry>

    <!-- How far the effect reaches, in cell pitches, x100. Unitless already, so
         it scales with the dock by construction. -->
    <entry name="falloffRadius" type="Int">
      <label>Reach of the magnification, in cell pitches x100</label>
      <default>300</default>
      <min>100</min>
      <max>800</max>
    </entry>

    <!-- Shape of the falloff between peak and rest, x100. Higher is flatter at
         the peak and steeper at the edges. -->
    <entry name="curveExponent" type="Int">
      <label>Shape of the magnification falloff, x100</label>
      <default>160</default>
      <min>50</min>
      <max>400</max>
    </entry>

    <!-- Animation speed as a percentage of normal: higher is faster, and 0
         disables animation outright. One multiplier over every duration rather
         than a key per animation — the durations themselves are a property of
         the design and are not individually negotiable. 0 is also what an
         accessibility setting for reduced motion will drive (Phase 8). -->
    <entry name="animationSpeed" type="Int">
      <label>Animation speed, as a percentage of normal</label>
      <default>100</default>
      <min>0</min>
      <max>400</max>
    </entry>

    <!-- The visibility switch for the running dot only. Indicator *style* is an
         appearance setting and lands with the rest of Phase 7's appearance page. -->
    <entry name="showRunningIndicators" type="Bool">
      <label>Show an indicator under applications that are running</label>
      <default>true</default>
    </entry>

    <!-- False: minimized windows get their own region of tiles. True: they
         collapse into the application's own tile. -->
    <entry name="minimizeIntoIcon" type="Bool">
      <label>Show minimized windows on the application's tile instead of their own</label>
      <default>false</default>
    </entry>

    <!-- How long a drag has to rest on a tile before the tile acts on it.
         0 turns spring-loading off outright: it is the one drag behaviour that
         happens without a release, so it has to be refusable. The default is
         deliberately on the slow side of the reference behaviour — an
         accidental spring-load interrupts what the user was actually doing. -->
    <entry name="springLoadDelay" type="Int">
      <label>Delay before a drag resting on a tile activates it, in milliseconds</label>
      <default>700</default>
      <min>0</min>
      <max>3000</max>
    </entry>

    <entry name="pinnedEntries" type="StringList">
      <label>Desktop entry ids pinned to the dock, in order</label>
      <default></default>
    </entry>
  </group>
</kcfg>
